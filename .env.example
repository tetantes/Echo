# ==================== YOUR REAL TELEGRAM ACCOUNT (userbot) ====================
# Get these from https://my.telegram.org -> API Development Tools
TG_API_ID=your_api_id
TG_API_HASH=your_api_hash

# Generated once by running `npm run login` interactively (see README).
# This is as sensitive as your Telegram password — never share it or commit it.
TG_SESSION_STRING=

# ==================== CONTROL PANEL BOT ====================
# A separate, free bot token from @BotFather (e.g. "EchoControlBot").
# This bot ONLY talks to you — it's the tappable panel, not your real account.
PANEL_BOT_TOKEN=your_botfather_token

# Your own numeric Telegram ID — the ONLY id allowed to use the control panel.
# Get it from @userinfobot.
OWNER_TELEGRAM_ID=your_numeric_telegram_id

# ==================== DATABASE ====================
DATABASE_URL=postgresql://user:pass@host/dbname

# ==================== GEMINI ====================
# You can also set/change this later from the control panel itself (🔑 Gemini Key),
# which is safer than leaving it in a hosting provider's plaintext env vars.
GEMINI_API_KEY=

PORT=3001
